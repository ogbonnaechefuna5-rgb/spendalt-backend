{
  "info": {
    "name": "Spendalt API",
    "description": "Complete API collection for Spendalt backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+2348012345678\",\n  \"password\": \"test123\",\n  \"full_name\": \"Test User\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+2348012345678\",\n  \"password\": \"test123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/user/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/user/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Name\",\n  \"email\": \"test@example.com\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Ingest SMS",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/transactions/ingest/sms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raw_text\": \"GTBank: Your account has been debited with NGN5,000.00 at KFC Lagos. Balance: NGN45,000.00\"\n}"
            }
          }
        },
        {
          "name": "Manual Entry",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/transactions/ingest/manual",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000.00,\n  \"transaction_type\": \"debit\",\n  \"description\": \"Lunch at KFC\",\n  \"category\": \"Food\",\n  \"transaction_date\": \"2024-01-15T12:30:00Z\"\n}"
            }
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/transactions"
          }
        }
      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "Create Budget",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/budgets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Food\",\n  \"amount\": 50000.00,\n  \"period\": \"monthly\",\n  \"start_date\": \"2024-01-01\",\n  \"end_date\": \"2024-01-31\"\n}"
            }
          }
        },
        {
          "name": "Get Budgets",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/budgets"
          }
        }
      ]
    },
    {
      "name": "Savings",
      "item": [
        {
          "name": "Create Goal",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/savings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Fund\",\n  \"target_amount\": 500000.00,\n  \"deadline\": \"2024-12-31\"\n}"
            }
          }
        },
        {
          "name": "Get Goals",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/savings"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Insights",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/analytics/insights"
          }
        },
        {
          "name": "Weekly Trend",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/analytics/weekly-trend"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Get Financial Health Score",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/health/score"
          }
        }
      ]
    }
  ]
}
